# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings → API). .env.local is gitignored by default.
#
# NEXT_PUBLIC_SUPABASE_URL is just the project base URL
# (https://<project-ref>.supabase.co) — no /rest/v1/ or other path suffix,
# the Supabase client appends those itself.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose to the client / NEXT_PUBLIC_*. Only needed for
# server-side code that must bypass Row Level Security (admin tasks, seed
# scripts). Most app code should use the anon key + RLS policies instead.
SUPABASE_SERVICE_ROLE_KEY=

# Web Push (VAPID). Generate a pair with `npx web-push generate-vapid-keys`.
# The public key is safe to expose client-side (NEXT_PUBLIC_*); the private
# key is server-only, used to sign push messages sent via web-push.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URI the push service can reach you at if it needs to (per the Web
# Push protocol) — any mailto: or https: URL works.
VAPID_SUBJECT=mailto:admin@example.com
